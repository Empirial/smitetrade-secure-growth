rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // 🛡️ DEFENSIVE HELPERS
    // ─────────────────────────────────────────────
    
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Defensive user document fetch (Fixes Point 1)
    function userDoc() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data
        : null;
    }

    function role() {
      let doc = userDoc();
      return doc != null ? doc.role : null;
    }

    function storeId() {
      let doc = userDoc();
      return doc != null ? doc.storeId : null;
    }

    // Check for specific roles or multiple roles (Fixes Point 9)
    function hasRole(r) {
      let d = userDoc();
      return d != null && (d.role == r || d.get('roles', []).hasAny([r]));
    }

    function isAdmin()    { return isAuth() && hasRole('admin'); }
    function isOwner()    { return isAuth() && hasRole('owner'); }
    function isCashier()  { return isAuth() && hasRole('cashier'); }
    function isDriver()   { return isAuth() && hasRole('driver'); }
    function isLender()   { return isAuth() && hasRole('lender'); }

    // Store Access Logic
    function ownsStore(sid) {
      return sid != null &&
             exists(/databases/$(database)/documents/stores/$(sid)) &&
             get(/databases/$(database)/documents/stores/$(sid)).data.ownerId == uid();
    }

    function canAccessStore(sid) {
      return sid == storeId() || ownsStore(sid) || isAdmin();
    }

    // ─────────────────────────────────────────────
    // 👤 USERS (Hardened against Role Escalation)
    // ─────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isAuth() && uid() == userId;
      allow list: if isAuth() && (uid() == userId || isAdmin() || isOwner());
      allow create: if isAuth() && uid() == userId;
      
      // FIX: Prevent users from changing their own role/storeId (Point 2)
      allow update: if isAuth() && (
        isAdmin() || 
        (uid() == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'storeId']))
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // 📦 STORE DATA (Hardened against Store Hopping)
    // ─────────────────────────────────────────────
    
    // Helper to validate that storeId is never changed during an update (Point 4)
    function isStoreIdImmutable() {
      return request.resource.data.storeId == resource.data.storeId;
    }

    match /products/{productId} {
      allow read: if isAuth() && canAccessStore(resource.data.storeId);
      allow create: if isAuth() && (isOwner() || isAdmin()) && canAccessStore(request.resource.data.storeId);
      allow update: if isAuth() && canAccessStore(resource.data.storeId) && isStoreIdImmutable();
      allow delete: if isAuth() && (isAdmin() || (isOwner() && canAccessStore(resource.data.storeId)));
    }

    match /orders/{orderId} {
      allow read: if isAuth() && (canAccessStore(resource.data.storeId) || resource.data.userId == uid() || resource.data.driverId == uid());
      allow create: if isAuth() && canAccessStore(request.resource.data.storeId);
      allow update: if isAuth() && (
        isAdmin() || 
        (canAccessStore(resource.data.storeId) && isStoreIdImmutable()) || 
        (resource.data.driverId == uid() && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']))
      );
    }

    // Applied same logic to remaining store collections
    match /customers/{customerId} {
      allow read, write: if isAuth() && canAccessStore(resource.data.storeId || request.resource.data.storeId);
    }
    match /expenses/{expenseId} {
      allow read, write: if isAuth() && canAccessStore(resource.data.storeId || request.resource.data.storeId);
    }
    match /suppliers/{supplierId} {
      allow read, write: if isAuth() && canAccessStore(resource.data.storeId || request.resource.data.storeId);
    }
    match /staff/{staffId} {
      allow read, write: if isAuth() && canAccessStore(resource.data.storeId || request.resource.data.storeId);
    }

    // ─────────────────────────────────────────────
    // 💰 FINANCE (Hardened: Server-Only Writes)
    // ─────────────────────────────────────────────
    
    match /transactions/{txId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == uid());
      // Only Cloud Functions should create/update transactions (Point 7)
      allow write: if false; 
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // Only Cloud Functions can write logs (Point 8)
      allow write: if false; 
    }

    // Keep remaining logic for Loans, Credit Profiles, etc.
    match /loans/{loanId} {
      allow read: if isAuth() && (isAdmin() || resource.data.lenderId == uid() || resource.data.borrowerId == uid());
      allow create: if isAuth() && (isLender() || isAdmin() || isOwner());
      allow update, delete: if isAuth() && (isAdmin() || resource.data.lenderId == uid());
    }
  }
}