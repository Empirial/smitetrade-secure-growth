rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPERS
    // Role is stored directly in users/{uid}.role
    // ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function role() {
      return userDoc().role;
    }

    function storeId() {
      return userDoc().storeId;
    }

    function isAdmin()    { return isAuth() && role() == 'admin'; }
    function isOwner()    { return isAuth() && role() == 'owner'; }
    function isCashier()  { return isAuth() && role() == 'cashier'; }
    function isDriver()   { return isAuth() && role() == 'driver'; }
    function isLender()   { return isAuth() && role() == 'lender'; }
    function isCustomer() { return isAuth() && role() == 'customer'; }

    // ─────────────────────────────────────────────
    // VALIDATION HELPERS
    // ─────────────────────────────────────────────
    function isValidOrder() {
      let d = request.resource.data;
      return d.total is number &&
             d.total >= 0 &&
             d.items is list &&
             d.items.size() > 0 &&
             d.status in ['Pending', 'Paid', 'Ready', 'Out for Delivery', 'Delivered', 'Cancelled'];
    }

    function isValidProduct() {
      let d = request.resource.data;
      return d.name is string &&
             d.price is number &&
             d.price >= 0 &&
             d.stock is number;
    }

    // ─────────────────────────────────────────────
    // USERS
    // Each user reads/writes their own doc.
    // Admin reads/writes all.
    // ─────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuth() && (uid() == userId || isAdmin() || isOwner());
      allow create: if isAuth() && uid() == userId;
      allow update: if isAuth() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // STORES
    // ─────────────────────────────────────────────
    match /stores/{docStoreId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isOwner() || isAdmin()) && request.resource.data.ownerId == uid();
      allow update: if isAuth() && (resource.data.ownerId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // PRODUCTS
    // ─────────────────────────────────────────────
    match /products/{productId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isOwner() || isAdmin()) && isValidProduct();
      allow update: if isAuth() && (
        isAdmin() ||
        (isOwner()   && resource.data.storeId == storeId()) ||
        (isCashier() && resource.data.storeId == storeId())
      );
      allow delete: if isAuth() && (
        isAdmin() ||
        (isOwner() && resource.data.storeId == storeId())
      );
    }

    // ─────────────────────────────────────────────
    // ORDERS
    // ─────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.storeId == storeId() ||
        resource.data.userId  == uid() ||
        resource.data.driverId == uid()
      );
      allow create: if isAuth() && isValidOrder();
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.storeId  == storeId() ||
        resource.data.driverId == uid()
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // CUSTOMERS (store tab customers)
    // ─────────────────────────────────────────────
    match /customers/{customerId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.storeId == storeId() ||
        uid() == customerId
      );
      allow create: if isAuth() && (isOwner() || isCashier() || isAdmin());
      allow update: if isAuth() && (isAdmin() || resource.data.storeId == storeId());
      allow delete: if isAuth() && (isAdmin() || (isOwner() && resource.data.storeId == storeId()));
    }

    // ─────────────────────────────────────────────
    // EXPENSES
    // ─────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow read:   if isAuth() && (isAdmin() || resource.data.storeId == storeId());
      allow create: if isAuth() && (isOwner() || isAdmin());
      allow update: if isAuth() && (isAdmin() || (isOwner() && resource.data.storeId == storeId()));
      allow delete: if isAuth() && (isAdmin() || (isOwner() && resource.data.storeId == storeId()));
    }

    // ─────────────────────────────────────────────
    // SUPPLIERS
    // ─────────────────────────────────────────────
    match /suppliers/{supplierId} {
      allow read:   if isAuth() && (isAdmin() || resource.data.storeId == storeId());
      allow create: if isAuth() && (isOwner() || isAdmin());
      allow update: if isAuth() && (isAdmin() || (isOwner() && resource.data.storeId == storeId()));
      allow delete: if isAuth() && (isAdmin() || (isOwner() && resource.data.storeId == storeId()));
    }

    // ─────────────────────────────────────────────
    // STAFF
    // ─────────────────────────────────────────────
    match /staff/{staffId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.storeId == storeId() ||
        uid() == staffId
      );
      allow create: if isAuth() && (isOwner() || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        (isOwner() && resource.data.storeId == storeId()) ||
        uid() == staffId
      );
      allow delete: if isAuth() && (isAdmin() || (isOwner() && resource.data.storeId == storeId()));
    }

    // ─────────────────────────────────────────────
    // SHIFTS
    // ─────────────────────────────────────────────
    match /shifts/{shiftId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.storeId  == storeId() ||
        resource.data.cashierId == uid()
      );
      allow create: if isAuth() && (isCashier() || isOwner() || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        resource.data.cashierId == uid() ||
        (isOwner() && resource.data.storeId == storeId())
      );
      allow delete: if isAdmin();

      match /cashDrops/{dropId} {
        allow read, write: if isAuth();
      }
    }

    // ─────────────────────────────────────────────
    // ISSUES (driver reports)
    // ─────────────────────────────────────────────
    match /issues/{issueId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.driverId == uid() ||
        resource.data.storeId  == storeId()
      );
      allow create: if isAuth() && (isDriver() || isAdmin());
      allow update: if isAuth() && (
        isAdmin() ||
        (isOwner() && resource.data.storeId == storeId()) ||
        resource.data.driverId == uid()
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // CREDIT PROFILES
    // ─────────────────────────────────────────────
    match /credit_profiles/{profileId} {
      allow read: if isAuth() && (
        isAdmin() ||
        uid() == profileId ||
        isLender() ||
        isOwner()
      );
      allow create: if isAuth() && uid() == profileId;
      allow update: if isAuth() && (uid() == profileId || isAdmin() || isLender());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // BORROWERS
    // Lenders see only their own borrowers.
    // ─────────────────────────────────────────────
    match /borrowers/{borrowerId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.lenderId == uid()
      );
      allow create: if isAuth() && (isLender() || isAdmin());
      allow update: if isAuth() && (isAdmin() || resource.data.lenderId == uid());
      allow delete: if isAuth() && (isAdmin() || resource.data.lenderId == uid());
    }

    // ─────────────────────────────────────────────
    // LOANS
    // ─────────────────────────────────────────────
    match /loans/{loanId} {
      allow read: if isAuth() && (
        isAdmin() ||
        resource.data.lenderId   == uid() ||
        resource.data.borrowerId == uid()
      );
      allow create: if isAuth() && (isLender() || isAdmin() || isOwner());
      allow update: if isAuth() && (isAdmin() || resource.data.lenderId == uid());
      allow delete: if isAuth() && (isAdmin() || resource.data.lenderId == uid());
    }

    // ─────────────────────────────────────────────
    // APPLICATIONS
    // ─────────────────────────────────────────────
    match /applications/{appId} {
      allow read: if isAuth() && (
        isAdmin() ||
        isLender() ||
        resource.data.userId == uid()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || isLender());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // LENDER OFFERS
    // ─────────────────────────────────────────────
    match /lender_offers/{offerId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isLender() || isAdmin());
      allow update: if isAuth() && (isAdmin() || resource.data.lenderId == uid());
      allow delete: if isAuth() && (isAdmin() || resource.data.lenderId == uid());
    }

    // ─────────────────────────────────────────────
    // NOTIFICATIONS
    // Users read their own. Authenticated users create (system sends to others).
    // ─────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == uid());
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || resource.data.userId == uid());
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // USER NOTIFICATIONS (read/dismissed tracking)
    // ─────────────────────────────────────────────
    match /user_notifications/{docId} {
      allow read, write: if isAuth() && uid() == docId;
    }

    // ─────────────────────────────────────────────
    // TRANSACTIONS (Paystack payment records)
    // ─────────────────────────────────────────────
    match /transactions/{txId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == uid());
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // DISPUTES
    // ─────────────────────────────────────────────
    match /disputes/{disputeId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == uid());
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // SUPPORT TICKETS
    // ─────────────────────────────────────────────
    match /support_tickets/{ticketId} {
      allow read: if isAuth() && (isAdmin() || resource.data.userId == uid());
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // AUDIT LOGS (admin read-only, anyone can create)
    // ─────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read:          if isAdmin();
      allow create:        if isAuth();
      allow update, delete: if false;
    }
  }
}
